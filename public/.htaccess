# SPA fallback when mod_rewrite is unavailable
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # iOS/Safari request these at the site root before reading HTML
  RewriteRule ^apple-touch-icon(-precomposed)?\.png$ icons/apple-icon-180x180.png [L]
  RewriteRule ^favicon\.ico$ icons/favicon.ico [L]

  # If the request is for a real file or folder, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise serve the SPA shell
  RewriteRule ^ index.html [L]
</IfModule>
